<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">

  <op:config name="%AMP_NumChannelsDefault%" value="%N%" />

  <ManufacturerData>
    <Manufacturer RefId="M-00FA">
      <ApplicationPrograms>
          <ApplicationProgram Id="%AID%" ApplicationNumber="300" ApplicationVersion="1" ProgramType="ApplicationProgram" MaskVersion="MV-07B0" Name="AMP" LoadProcedureStyle="MergedProcedure" PeiType="0" DefaultLanguage="de" DynamicTableManagement="false" Linkable="true" MinEtsVersion="6.0">
            <Static>
            <!-- Hier in der Share wird der Name des Includes angegeben, das die Teile eines Moduls enthält, die keine Wiederholstrukturen enthalten. -->
            <ParameterTypes>
              <ParameterType Id="%AID%_PT-AMPNumChannels" Name="AMPNumChannels">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="%N%" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-AMPChannelActive" Name="ChannelActive">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="Inaktiv" Value="0" Id="%ENID%" />
                  <Enumeration Text="Aktiv" Value="1" Id="%ENID%" />
                  <Enumeration Text="Funktionslos" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-Volume" Name="Volume">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="100" UIHint="Slider" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-VolumeStepValue" Name="VolumeStepValue">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="10" UIHint="Slider" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-AMPLock" Name="AMPLock">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="nicht aktiv" Value="0" Id="%ENID%" />
                  <Enumeration Text="gesperrt (1) / nicht gesperrt (0)" Value="1" Id="%ENID%" />
                  <Enumeration Text="gesperrt (0) / nicht gesperrt (1)" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-DayNight" Name="DayNight">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="nicht aktiv" Value="0" Id="%ENID%" />
                  <Enumeration Text="Tag (1) / Nacht (0)" Value="1" Id="%ENID%" />
                  <Enumeration Text="Tag (0) / Nacht (1)" Value="2" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-Source" Name="Source">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Netzwerk" Value="0" Id="%ENID%" />
                  <Enumeration Text="Bluetooth" Value="1" Id="%ENID%" />
                  <Enumeration Text="USB" Value="2" Id="%ENID%" />
                  <Enumeration Text="Line-In" Value="3" Id="%ENID%" />
                  <Enumeration Text="Optical" Value="4" Id="%ENID%" />
                  <Enumeration Text="Coax" Value="5" Id="%ENID%" />
                  <Enumeration Text="USBDAC" Value="6" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-mute" Name="mute">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="aktiv" Value="0" Id="%ENID%" />
                  <Enumeration Text="stumm" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-AMPAliveTimeInterval" Name="ZeitintervallAMPdeviceAlive[s]">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="120" UIHint="Slider" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-LimitmaxVolume" Name="LimitmaxVolume">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="100" UIHint="Slider" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-ValueSceneInNr" Name="ValueSceneIn">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Nicht genutzt" Value="0" Id="%ENID%" />
                  <Enumeration Text="Szene 1" Value="1" Id="%ENID%" />
                  <Enumeration Text="Szene 2" Value="2" Id="%ENID%" />
                  <Enumeration Text="Szene 3" Value="3" Id="%ENID%" />
                  <Enumeration Text="Szene 4" Value="4" Id="%ENID%" />
                  <Enumeration Text="Szene 5" Value="5" Id="%ENID%" />
                  <Enumeration Text="Szene 6" Value="6" Id="%ENID%" />
                  <Enumeration Text="Szene 7" Value="7" Id="%ENID%" />
                  <Enumeration Text="Szene 8" Value="8" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-SceneMuteState" Name="SceneMuteState">
                  <TypeRestriction Base="Value" SizeInBit="8">
                    <Enumeration Text="Keine Änderung" Value="0" Id="%ENID%" />
                    <Enumeration Text="Mute ein"       Value="1" Id="%ENID%" />
                    <Enumeration Text="Mute aus"       Value="2" Id="%ENID%" />
                  </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-ScenePreset" Name="ScenePreset">
                  <TypeRestriction Base="Value" SizeInBit="8">
                    <Enumeration Text="Nicht genutzt" Value="0" Id="%ENID%" />
                    <Enumeration Text="Preset 1"      Value="1" Id="%ENID%" />
                    <Enumeration Text="Preset 2"      Value="2" Id="%ENID%" />
                    <Enumeration Text="Preset 3"      Value="3" Id="%ENID%" />
                    <Enumeration Text="Preset 4"      Value="4" Id="%ENID%" />
                    <Enumeration Text="Preset 5"      Value="5" Id="%ENID%" />
                    <Enumeration Text="Preset 6"      Value="6" Id="%ENID%" />
                    <Enumeration Text="Preset 7"      Value="7" Id="%ENID%" />
                    <Enumeration Text="Preset 8"      Value="8" Id="%ENID%" />
                  </TypeRestriction>
              </ParameterType>
              
              <ParameterType Id="%AID%_PT-Preset" Name="Preset">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="8" />
                <!-- TODO Wertebereich für Preset prüfen-->
              </ParameterType>
            </ParameterTypes>

            <Parameters>
              <Parameter Id="%AID%_P-%TT%00002" Name="CheckForOneChannel" ParameterType="%AID%_PT-CheckBox" Text="" Value="1" Access="None" />
              <Union SizeInBit="8">
                <Memory CodeSegment="%AID%_RS-04-00000" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00001" Name="VisibleChannels" ParameterType="%AID%_PT-AMPNumChannels" Offset="0" BitOffset="0" Text="Verfügbare Kanäle" Value="%AMP_NumChannelsDefault%" SuffixText=" von %N%" />
                <!-- 7 bits free -->
              </Union>
            </Parameters>

            

            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" /> <!-- VisibleChannels -->
              <ParameterRef Id="%AID%_P-%TT%00002_R-%TT%0000201" RefId="%AID%_P-%TT%00002" /> <!-- CheckForOneChannel -->
            </ParameterRefs>    
          </Static>
          
          <Dynamic>
            <Channel Id="%AID%_CH-%PREFIX%" Number="%PREFIX%" Name="Main" Text="PowerAmp" Icon="speaker">
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings" Text="Allgemein" Icon="cog-outline" ShowInComObjectTree="true">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="PowerAmp Version %ModuleVersion%" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

                <ParameterRefRef RefId="%AID%_P-%TT%00002_R-%TT%0000201" /> <!-- CheckForOneChannel -->
                <choose ParamRefId="%AID%_P-%TT%00002_R-%TT%0000201"> <!-- CheckForOneChannel -->
                  <when test="!=%N%">
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" />
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                  </when>
                  <when test="%N%">
                    <Assign TargetParamRefRef="%AID%_UP-%TT%00001_R-%TT%0000101" Value="1" /> <!-- VisibleChannels -->
                  </when>
                </choose>
              </ParameterBlock>
              <op:include href="PowerAmp.templ.xml" xpath="//ApplicationProgram/Dynamic/ChannelIndependentBlock/*" type="template" prefix="AMP" IsInner="true" />
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>
